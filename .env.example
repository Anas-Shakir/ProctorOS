# ==============================================================================
# ProctorOS Environment Variables
# Copy this file to `.env` for local development, and add the same variables
# in your Vercel Project Settings before deploying.
#
# NOTE: Per the Web-e-Thon Build Playbook, we use Supabase strictly as plain
# PostgreSQL via Prisma. You do NOT need Supabase Auth keys (ANON/SERVICE_ROLE)
# or any paid third-party API keys.
# ==============================================================================

# 1. Supabase PostgreSQL — Pooled connection string (used by app runtime / Prisma Client)
# From Supabase Dashboard -> Connect -> Transaction pooler (port 6543, includes ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Supabase PostgreSQL — Direct connection string (used by `prisma migrate` only)
# From Supabase Dashboard -> Connect -> Direct connection (port 5432)
DIRECT_URL="postgresql://postgres:[YOUR-DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# 3. Session signing secret (for `jose` JWT in httpOnly cookie)
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-64-char-random-hex-secret"

# 4. Verifiable PDF report HMAC secret (for `ReportToken` signatures in Stage 9)
# Generate a separate random secret with the same command above
REPORT_SECRET="replace-with-another-64-char-random-hex-secret"

# 5. Public base URL (used when generating QR verification links inside PDFs)
# Locally: http://localhost:3000 | Production: https://your-project.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
